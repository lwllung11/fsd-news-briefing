              "name": "香港電台",
              "url": "https://news.rthk.hk/rthk/ch/component/k2/1877155-20261109.htm"
            }
          ],
          "publishedAt": "2026-11-09",
          "firstAppearedAt": "2026-11-09T18:40:00+08:00"
